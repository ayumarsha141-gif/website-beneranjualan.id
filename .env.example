# Copy this file to .env and fill in values. Never commit .env.
APP_ENV=production
APP_DEBUG=0
# Public base URL without trailing slash, e.g. https://beneranjualan.id
APP_URL=https://example.com

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=beneranjualan
DB_USER=beneranjualan_app
DB_PASS=change-me

# Set to 1 when the site is served over HTTPS
SESSION_COOKIE_SECURE=1
